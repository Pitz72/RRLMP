<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0F172A"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RUNTIME LIVE MACHINE PRO"
        android:textColor="#E2E8F0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Regia Remota — indirizzo del PC in regia"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="28dp" />

    <EditText
        android:id="@+id/host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Indirizzo IP (es. 192.168.1.50)"
        android:textColorHint="#64748B"
        android:textColor="#E2E8F0"
        android:inputType="textNoSuggestions"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/port"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Porta"
        android:text="8787"
        android:textColorHint="#64748B"
        android:textColor="#E2E8F0"
        android:inputType="number"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/connect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connetti"
        android:textColor="#0F172A"
        android:backgroundTint="#0EA5E9" />

    <Button
        android:id="@+id/discover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Cerca automaticamente il PC"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:backgroundTint="#1E293B" />

</LinearLayout>
