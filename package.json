{
    "name": "rrlmp",
    "version": "0.1.2fix1",
    "description": "Runtime Radio Live Machine Pro",
    "main": "out/main/index.js",
    "scripts": {
        "dev": "vite",
        "build:main": "tsc -p tsconfig.main.json",
        "build:preload": "tsc -p tsconfig.preload.json",
        "build": "npm run build:main && npm run build:preload && vite build && electron-builder",
        "preview": "vite preview"
    },
    "build": {
        "appId": "com.antigravity.rrlmp",
        "productName": "RRLMP",
        "directories": {
            "output": "builds/v0.1.2fix1"
        },
        "files": [
            "out/**/*",
            "package.json"
        ],
        "win": {
            "target": "nsis"
        }
    },
    "keywords": [],
    "author": "Antigravity",
    "license": "ISC",
    "dependencies": {
        "clsx": "^2.1.0",
        "lucide-react": "^0.300.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tailwind-merge": "^2.2.0",
        "uuid": "^9.0.1",
        "zustand": "^4.5.0"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@types/uuid": "^9.0.7",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.16",
        "electron": "^28.1.0",
        "electron-builder": "^24.9.1",
        "postcss": "^8.4.33",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.3.3",
        "vite": "^5.0.11"
    }
}