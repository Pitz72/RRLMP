{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": false,
        "noEmit": false,
        "outDir": "out/main",
        "rootDir": "src/main",
        "target": "ESNext",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "allowImportingTsExtensions": false
    },
    "include": [
        "src/main/**/*"
    ],
    // v1.15.37: i test non vanno compilati in out/main (finivano dentro app.asar,
    // installati sul PC di regia). Restano verificati da tsconfig.json e da Vitest.
    "exclude": [
        "src/main/**/__tests__/**"
    ]
}